{
  "name": "workflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "check": "node scripts/check.ts",
    "check:real": "node src/cli.ts archive && node src/check.ts",
    "fixtures": "node scripts/fixtures.ts",
    "golden:update": "WORKFLOW_GOLDEN_UPDATE=1 node --import ./scripts/test-config.ts --test test/golden.test.ts",
    "showcase": "node --import ./scripts/test-config.ts scripts/showcase.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "gpt-tokenizer": "^4.1.0"
  },
  "license": "MIT",
  "overrides": {
    "undici-types": "^8.12.3"
  }
}
